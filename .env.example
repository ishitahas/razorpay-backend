# ---- Option A: real Razorpay (Test Mode keys from the dashboard) ----
# MOCK_MODE=false
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Option B: no Razorpay account yet (local mock, any secret works) ----
MOCK_MODE=true
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=my_local_test_secret

# Optional: webhook secret (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

PORT=3000
BASE_URL=http://localhost:3000
